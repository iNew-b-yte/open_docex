{
  "name": "@open-docex/shared",
  "version": "0.1.1",
  "description": "Shared contracts for open_docex: the wire protocol, the error catalogue, ids, and the text document model with its operational transform. Used by @open-docex/server and @open-docex/client.",
  "keywords": [
    "open-docex",
    "collaborative-editing",
    "real-time",
    "realtime-collaboration",
    "document-collaboration",
    "document-editor",
    "word-processor",
    "docx",
    "odt",
    "operational-transformation",
    "self-hosted",
    "on-premises",
    "open-source",
    "typescript",
    "protocol",
    "error-codes",
    "prosemirror",
    "document-model",
    "ot"
  ],
  "homepage": "https://github.com/iNew-b-yte/open_docex#readme",
  "bugs": {
    "url": "https://github.com/iNew-b-yte/open_docex/issues"
  },
  "license": "MIT",
  "author": "Naveen Kumar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iNew-b-yte/open_docex.git",
    "directory": "shared"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@open-docex/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./protocol": {
      "@open-docex/source": "./src/protocol/index.ts",
      "types": "./dist/protocol/index.d.ts",
      "import": "./dist/protocol/index.js"
    },
    "./errors": {
      "@open-docex/source": "./src/errors/index.ts",
      "types": "./dist/errors/index.d.ts",
      "import": "./dist/errors/index.js"
    },
    "./ids": {
      "@open-docex/source": "./src/ids/index.ts",
      "types": "./dist/ids/index.d.ts",
      "import": "./dist/ids/index.js"
    },
    "./ot": {
      "@open-docex/source": "./src/ot/index.ts",
      "types": "./dist/ot/index.d.ts",
      "import": "./dist/ot/index.js"
    },
    "./text": {
      "@open-docex/source": "./src/text/index.ts",
      "types": "./dist/text/index.d.ts",
      "import": "./dist/text/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.test.json",
    "prepack": "node -e \"require('fs').copyFileSync('../LICENSE', 'LICENSE')\""
  },
  "dependencies": {
    "prosemirror-model": "^1.25.13",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.12.6"
  }
}
