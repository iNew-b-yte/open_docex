<?xml version="1.0" encoding="UTF-8"?>
<!-- Spike S2 fixture: EMF, WMF, TIFF and SVG images (PO-22). Hand-written for open_docex (MIT).
     @@IMG:x@@ placeholders are filled with base64 by spikes/S2/build-fixtures.mjs. -->
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.text">
 <office:styles><style:style style:name="Standard" style:family="paragraph" style:class="text"/></office:styles>
 <office:automatic-styles>
  <style:page-layout style:name="pm1"><style:page-layout-properties fo:page-width="210mm" fo:page-height="297mm" style:print-orientation="portrait" fo:margin-top="20mm" fo:margin-bottom="20mm" fo:margin-left="20mm" fo:margin-right="20mm"/></style:page-layout>
  <style:style style:name="fr1" style:family="graphic"><style:graphic-properties style:wrap="none" style:vertical-pos="top" style:vertical-rel="baseline"/></style:style>
 </office:automatic-styles>
 <office:master-styles><style:master-page style:name="Standard" style:page-layout-name="pm1"/></office:master-styles>
 <office:body>
  <office:text>
   <text:p text:style-name="Standard"><draw:frame draw:style-name="fr1" draw:name="ImgEmf" text:anchor-type="as-char" svg:width="32mm" svg:height="16mm" draw:z-index="0"><draw:image draw:mime-type="image/x-emf"><office:binary-data></office:binary-data></draw:image><svg:title>ALT-EMF</svg:title></draw:frame></text:p>
   <text:p text:style-name="Standard"><draw:frame draw:style-name="fr1" draw:name="ImgWmf" text:anchor-type="as-char" svg:width="32mm" svg:height="16mm" draw:z-index="1"><draw:image draw:mime-type="image/x-wmf"><office:binary-data></office:binary-data></draw:image><svg:title>ALT-WMF</svg:title></draw:frame></text:p>
   <text:p text:style-name="Standard"><draw:frame draw:style-name="fr1" draw:name="ImgTif" text:anchor-type="as-char" svg:width="32mm" svg:height="16mm" draw:z-index="2"><draw:image draw:mime-type="image/tiff"><office:binary-data></office:binary-data></draw:image><svg:title>ALT-TIFF</svg:title></draw:frame></text:p>
   <text:p text:style-name="Standard"><draw:frame draw:style-name="fr1" draw:name="ImgSvg" text:anchor-type="as-char" svg:width="32mm" svg:height="16mm" draw:z-index="3"><draw:image draw:mime-type="image/svg+xml"><office:binary-data></office:binary-data></draw:image><svg:title>ALT-SVG</svg:title></draw:frame></text:p>
   <text:p text:style-name="Standard">END-OF-DOC</text:p>
  </office:text>
 </office:body>
</office:document>
